# Toque — environment variables. Copy to .env.local for local overrides.
# Every variable is optional in development; production needs the ones marked REQUIRED.

# --- Database ---
# Neon Postgres connection string. Unset → PGlite in .data/pglite (zero setup).
DATABASE_URL=
# PGlite folder when DATABASE_URL is unset. "memory://" = in memory (e2e runs).
TOQUE_PGLITE_DIR=

# --- Auth ---
# REQUIRED in production. The single login password (dev default: "toque").
TOQUE_PASSWORD=
# REQUIRED in production. Signs the session cookie; at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOQUE_SESSION_SECRET=

# --- Public URL ---
# Origin written into NFC tag URLs and notification links, e.g. https://toque.example.pt
# Unset → the request origin (tags) / VERCEL_PROJECT_PRODUCTION_URL (notifications).
TOQUE_PUBLIC_URL=

# --- Engine / cron ---
# REQUIRED for /api/tick. The external cron sends "Authorization: Bearer <value>".
TOQUE_CRON_SECRET=
# Signs the "done"/"snooze" buttons on notifications (≥ 16 chars). Unset → no buttons work.
TOQUE_ACTION_SECRET=

# --- ntfy ---
# Fallback topic when none is set in the app settings.
NTFY_TOPIC=
# Overrides the ntfy server (default https://ntfy.sh, or the one in settings).
NTFY_BASE_URL=
# Access token for a protected ntfy topic/server.
NTFY_TOKEN=

# --- Development only ---
# Mock /api in the PWA: "1" = all routes, or a comma list like "dashboard,events".
NEXT_PUBLIC_TOQUE_MOCKS=
